includes:
	- base.neon

parameters:
    environment: 'production'
    database:
        host: jacq-pgsql-cluster-rw
        password: %env.DB_PASSWORD%
    storage:
        archiveBucketPrefix: archive
        jp2BucketPrefix: iiif
        thumbBucketPrefix: thumbs1280
        recentBucketSuffix: ""
        imageServerBaseUrl: https://rais-iiif.dyn.cloud.e-infra.cz/iiif/
    databot:
        basePath: http://127.0.0.1:5000
    solr:
        basePath: http://127.0.0.1:8983


aws:
    endpoint: https://s3.cl4.du.cesnet.cz
    use_path_style_endpoint: false
    credentials:
        key: %env.S3_ACCESS_KEY%
        secret: %env.S3_SECRET_KEY%

http:
    proxy:
        - 10.42.0.0/16

di:
    lazy: true
