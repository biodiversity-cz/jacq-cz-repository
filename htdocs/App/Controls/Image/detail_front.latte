<div class="col">
    <div class="card">
        <div class="row g-0">
            <div class="col-md-4">
                {if $photo->getStatus()->getId() === 3 || $photo->getStatus()->getId() === 4}
                <img
                    src="{plink Repository:databotThumbImage $photo->getId()}"
                    width="300px" class="img-fluid rounded-start">
                {/if}
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title">ID {$photo->getId()}</h5>
                    <p class="card-text">Archive Master filename: {$photo->getArchiveFilename()} <a
                        href="{plink Repository:archiveImage $photo->getId()}">download</a></p>
                    <p class="card-text">JP2 format: {$photo->getJp2Filename()} <a
                        href="{plink Repository:jp2Image $photo->getId()}">download</a></p>
                    <p class="card-text">W×H: {$photo->getWidth()}×{$photo->getHeight()}</p>
                    <p class="card-text">Type: <span class="badge bg-{$photo->getType()->getColor()}">{$photo->getType()->getName()}</span> </p>
                    <p class="card-text">Filesize: {$photo->getArchiveFileSize()|bytes:2}</p>
                    <p class="card-text"><small class="text-muted">Imported at
                        {$photo->getCreatedAt()|localDate}</small></p>
                </div>
            </div>
        </div>
    </div>
</div>
