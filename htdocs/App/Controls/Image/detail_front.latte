<div class="col">
    <div class="card">
        <div class="row g-0">
            <div class="col-md-4">
                {if $photo->status->id === 3 || $photo->status->id === 4}
                <img
                    src="{plink Repository:databotThumbImage $photo->id}"
                    width="300px" class="img-fluid rounded-start">
                {/if}
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title">ID {$photo->id}</h5>
                    <p class="card-text">Archive Master filename: {$photo->archiveFilename} <a
                        href="{plink Repository:archiveImage $photo->id}">download</a></p>
                    <p class="card-text">JP2 format: {$photo->jp2Filename} <a
                        href="{plink Repository:jp2Image $photo->id}">download</a></p>
                    <p class="card-text">W×H: {$photo->width}×{$photo->height}</p>
                    <p class="card-text">Type: <span class="badge bg-{$photo->type->color}">{$photo->type->name}</span> </p>
                    <p class="card-text">Filesize: {$photo->archiveFileSize|bytes:2}</p>
                    <p class="card-text"><small class="text-muted">Imported at
                        {$photo->createdAt|localDate}</small></p>
                    <p> <a href="{plink Repository:image $photo->id}">Detail of image</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
