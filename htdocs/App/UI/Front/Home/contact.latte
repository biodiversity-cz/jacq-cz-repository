{block content}
<h2>Main contact</h2>
<address class="mb-5">
    Herbarium {$mainContact->acronym}, {$mainContact->fullname}  {$mainContact->address}
</address>

<h3>Participating herbaria</h3>
<hr class="col-4" />
{foreach $herbaria as $herbarium}
<div class="row mt-4">
    <div class="col-md-2">
        <h4>Herbarium {$herbarium->acronym}</h4>
{if $herbarium->logo!==null}<img src="{$herbarium->logo}" class="img-fluid">{/if}

        <address><b>{$herbarium->fullname}</b> <br>
            {$herbarium->address}</address>
    </div>
    <div class="col-md-9">
        <table class="table table-striped table-hover table-fixed">
            <thead>
            <tr>
                <th scope="col" class="w-30">Name</th>
                <th scope="col" class="w-40">Position</th>
                <th scope="col" class="w-30">Email</th>
            </tr>
            </thead>
            <tbody>
            {foreach $herbarium->contacts as $contact}
            <tr>
                <td class="w-30">{$contact->getFullname()}</td>
                <td class="w-40">{$contact->description}</td>
                <td class="w-30">{$contact->email|email}</td>
            </tr>
            {/foreach}
            </tbody>
        </table>
    </div>
</div>

{/foreach}
