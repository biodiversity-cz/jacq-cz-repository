{block content}
<div class="container-fluid">
    <h2>Resolve problems with file <em>{$photo->originalFilename}</em> <span class="fs-5">[task {$photo->id}] or go back to  <a n:href=":default#third-tab-pane">upload results</a></span></h2>

    <div class="row">
        <div class="col-md-3">
            <p><b>error:</b> {$photo->error->message}</p>
            {if $photo->error->barcodes!== null}
            <p><b>detected barcode (s):</b> {$photo->error->barcodes}</p>
            {/if}
            <p>Please decide what to do with this image: </p>

            <p><a n:href=":reimport $photo->id" id="reupload" class="btn btn-primary btn-sm" role="button">Repeat
                processing</a> - the file is ok and the error reported looks like a temporal error of the repository.</p>
            <p><a n:href=":delete $photo->id" id="delete" class="btn btn-danger btn-sm" role="button">Delete</a> -
                delete the file from my bucket and erase the information about its processing.</p>
            <hr width="70%">
            <p>The file could be fine, but the automatic barcode processing failed. If so, enter the numeric part of
                specimen ID. The image will be reprocessed, skipping the barcode detection. </p>


            <form n:name=specimenIdForm class=form>
                <ul class="errors" n:ifcontent>
                    <li n:foreach="$form->getOwnErrors() as $error">{$error}</li>
                </ul>
                <div class="row g-3 align-items-center">
                    <div class="col-auto">
                        <label n:name=specimen class="form-label">{$herbarium->acronym}-</label>
                    </div>
                    <div class="col-auto">
                        <input n:name=specimen  type="number" style=" width: 8em;" class="form-control" aria-describedby="helpInline" autofocus placeholder="12345">
                    </div>
                    <div class="col-auto">
                        <span n:ifcontent{inputError specimen} id="helpInline" class="form-text error"></span>
                    </div>
                </div>
                <div class="row mt-3 align-items-center">
                    <div class="col-auto">
                    </div>
                    <div class="col-auto">
                        <input n:name=submit class="btn btn-secondary btn-sm" role="button">
                    </div>
                </div>
            </form>

        </div>
        {if $photo->error->duplicateTo}
        <div class="col-md-4">
            <h5>NEW image being imported <span class="fs-6">(<a href="{link :thumbnail $photo->id}" target="_blank">full preview</a>)</span></h5>
            <img src="{link :thumbnail $photo->id}" class="img-fluid"  style="height: 90vh; object-fit: cover;">
        </div>
        <div class="col-md-4">
            <h5>EXISTING image from the repository (thumb)</h5>
            <img src="{link :databotThumbImage $photo->error->duplicateTo->id}"
                class="img-fluid rounded-start" style="height: 90vh; object-fit: cover;">
        </div>
        {else}
        <div class="col-md-4">
            <h5>NEW image being imported <span class="fs-6">(<a href="{link :thumbnail $photo->id}" target="_blank">full preview</a>)</span></h5>
            <img src="{link :thumbnail $photo->id}" class="img-fluid" style="height: 90vh; object-fit: cover;">
        </div>
        {/if}

    </div>

</div>
