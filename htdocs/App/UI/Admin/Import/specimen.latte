{block content}
<div class="container">
<div class="row">
    <h2>Detail of specimen</h2>
    <p>Herbarium: {$images[0]->getHerbarium()->getAcronym()}</p>
    <p>Specimen: {$specimen->getStandardizedId()}</p>
    <p>Specimen Persistent ID (=link to JACQ): <a href="{$images[0]->getJacqPid()}">{$images[0]->getJacqPid()}</a></p>
    <p>IIIF manifest: <a href="{$manifestAbsoluteLink}">{$manifestAbsoluteLink}</a></p>
    <h4>Photos</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">
        {foreach $images as $image}
        {control 'detail-' . $image->getId() false}
        {/foreach}
    </div>
</div>
</div>



