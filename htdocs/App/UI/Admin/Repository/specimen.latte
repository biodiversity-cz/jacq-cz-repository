{block content}
<div class="container">
    <div class="row">
        <div class="col-4">
            {control specimen $images[0]}
        </div>
        <div class="col-8">
            <div class="row row-cols-1 row-cols-md-2 g-4">
                {foreach $images as $image}
                {control 'detail-' . $image->id false}
                {/foreach}
            </div>
        </div>
    </div>
</div>
