{block content}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Herbarium {$herbarium->acronym} {$herbarium->fullname}</h2>

        {if count($availableHerbaria) > 1}
        <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" id="herbariumSwitcher" data-bs-toggle="dropdown" aria-expanded="false">
                Switch Herbarium
            </button>
            <ul class="dropdown-menu" aria-labelledby="herbariumSwitcher">
                {foreach $availableHerbaria as $availableHerbarium}
                <li><a class="dropdown-item {if $availableHerbarium->id === $herbarium->id}active{/if}" href="{link switchHerbarium!, herbariumId => $availableHerbarium->id}">{$availableHerbarium->acronym} {if $availableHerbarium->fullname}- {$availableHerbarium->fullname}{/if}</a></li>
                {/foreach}
            </ul>
        </div>
        {/if}
    </div>

    <div class="row">

        <p>Validity of the barcode and its transformation in herbarium specimen ID is compared using a regular
            expression assigned to your herbarium: </p>
        <code class="text-center fs-3" id="barcodeRegex">{$herbarium->regexBarcode}</code>
        <p class="fw-light">You can understand it easily with the ChatGPT, an online <a href="https://regex101.com/">tool</a>,
            or ask the repository administrator to fit it according your needs.</p>


        <div class="mb-3 row">
            <label for="barcodeRegexInput" class="col-sm-2 col-md-1 col-form-label fw-bold">Test it:</label>
            <div class="col-sm-5 col-md-3">
                <input type="text" class="form-control" id="barcodeRegexInput" placeholder="Enter a barcode content"
                       autofocus>
            </div>
            <div class="col-sm-1">
                <p class="fs-4">
                    <b style="color: #bebebe" class="barcodeRegexResult" id="barcodeRegexEmpty">?</b>
                    <b class="text-success barcodeRegexResult d-none" id="barcodeRegexOk">✓</b>
                    <b class="text-danger barcodeRegexResult d-none" id="barcodeRegexError">𐄂</b>
                </p>
            </div>
            <div class="col-sm-12 col-md-3">
                <input type="text" readonly class="form-control-plaintext" id="barcodeRegexHerbarium" value="">
            </div>
            <div class="col-sm-12 col-md-3">
                <input type="text" readonly class="form-control-plaintext" id="barcodeRegexNumber" value="">
            </div>
        </div>
        {if $herbarium->fallbackFilename}
        <hr>
        <div class="alert alert-secondary" role="alert">
            Specimen ID detection from the filename is ON <span class="badge bg-danger">not recommended</span>
        </div>
        <p class="ms-5">If <em>NO barcode is present</em> in the image, the specimen ID identification falls to the
            filename, using a regular expression evaluation again. This could be useful for some situation, but please
            do not overuse it, a preferred state is to include the barcode in the image in the "physical original". </p>
        <code class="text-center fs-5" id="filenameRegex">{$herbarium->regexFilename}</code>
        <div class="mb-3 mt-4 row">
            <label for="filenameRegexInput" class="col-sm-2 col-md-1 col-form-label fw-bold">Test it:</label>
            <div class="col-sm-5 col-md-4">
                <input type="text" class="form-control" id="filenameRegexInput"
                       placeholder="Enter a filename example including extension">
            </div>
            <div class="col-sm-1">
                <p class="fs-4">
                    <b style="color: #bebebe" class="filenameRegexResult" id="filenameRegexEmpty">?</b>
                    <b class="text-success filenameRegexResult d-none" id="filenameRegexOk">✓</b>
                    <b class="text-danger filenameRegexResult d-none" id="filenameRegexError">𐄂</b>
                </p>
            </div>
            <div class="col-sm-12 col-md-3">
                <input type="text" readonly class="form-control-plaintext" id="filenameRegexHerbarium" value="">
            </div>
            <div class="col-sm-12 col-md-3">
                <input type="text" readonly class="form-control-plaintext" id="filenameRegexNumber" value="">
            </div>
        </div>
        {/if}
        {if !$herbarium->strictBarcodeAcronymPrefix}
        <hr>
        <div class="alert alert-secondary" role="alert">
            Barcode content from imported image is not checked for a prefix equal to the herbarium acronym <span class="badge bg-danger">not recommended</span>
        </div>
        <p class="ms-5">This makes it weak/unpossible to control that the image belongs to the actual herbarium.</p>
        {/if}

        {if $herbarium->multipleBarcodeMultiplier}
        <hr>
        <div class="alert alert-secondary" role="alert">
            Multiple barcode Multiplier is ON <span class="badge bg-danger">not recommended</span>
        </div>
        <p class="ms-5">If <em>MULTIPLE VALID barcodes are present</em> in the image, the import process will clone the
            image to all of these codes. </p>
        {/if}
    </div>
    <div class="row mt-5">
        <div class="col-md-4 col-sm-12 offset-2">
            <h4>User accounts assigned to this herbarium</h4>
            <table class="table table-hover">
                <thead>
                <tr>
                    <th>username</th>
                    <th>role</th>
                </tr>
                </thead>
                <tbody>
                {foreach $herbarium->userHerbariumRoles as $role}
                <tr>
                    <td>
                        {$role->user->getFullname()}
                    </td>
                    <td>{$role->role->name}</td>
                </tr>
                {/foreach}

                </tbody>
            </table>
        </div>
        <div class="col-sm-12 col-md-4 offset-md-1  ">
            <h4 id="setSettings">Settings</h4>
            <table class="table table-hover">
                <thead>
                <tr>
                    <th>feature</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td>
                        <label class="form-check-label" for="filenameFallbackSwitch">Filename fallback</label>
                    </td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="filenameFallbackSwitch" data-target="{link :setSettings 'filenameFallbackSwitch'}" {if $herbarium->fallbackFilename}checked{/if} {if !$user->isInRole('curator')}disabled{/if}>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label class="form-check-label" for="multiplierSwitch">Multiplier</label>
                    </td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="multiplierSwitch" data-target="{link :setSettings 'multiplierSwitch'}" {if $herbarium->multipleBarcodeMultiplier}checked{/if} {if !$user->isInRole('curator')}disabled{/if}>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label class="form-check-label" for="strictAcronymPrefix">Acronym must be barcode prefix</label>
                    </td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="strictAcronymPrefix" data-target="{link :setSettings 'strictAcronymPrefix'}" {if $herbarium->strictBarcodeAcronymPrefix}checked{/if} {if !$user->isInRole('curator')}disabled{/if}>
                        </div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>
