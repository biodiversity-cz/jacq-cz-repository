{
	"name": "biodiversity-cz/jacq-cz-repository",
	"description": "JACQ - Czech integration",
	"keywords": ["jacq", "repository", "NRP"],
	"type": "project",
	"license": ["MIT"],
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/krkabol/iiif-manifest-generator"
    }
  ],
	"require": {
		"php": ">= 8.4",
    "ext-imagick": "*",
    "ext-intl": "*",
    "ext-exif": "*",
    "ext-zip": "*",
    "ext-dom": "*",
    "ext-xmlwriter": "*",

		"nette/application": "^3",
		"nette/bootstrap": "^3",
		"nette/caching": "^3",
		"nette/di": "^3",
		"nette/forms": "^3",
		"nette/http": "^3",
		"nette/mail": "^4",
		"nette/robot-loader": "^4",
		"nette/security": "^3",
    "nette/utils": "^4",
    "nettrine/orm": "^0",
    "nettrine/dbal": "^0",
    "nettrine/fixtures": "^0.8",
    "nettrine/migrations": "^0",
    "symfony/var-exporter": "^v7",
    "latte/latte": "^3",
    "tracy/tracy": "^2",

    "contributte/console": "^0",
    "contributte/console-extra": "^0",
    "guzzlehttp/guzzle": "^7",
    "league/pipeline": "^1",
    "ublaboo/aws-sdk-nette-extension": "dev-master",
    "ublaboo/datagrid": "^v7",
    "yale-web-technologies/iiif-manifest-generator": "dev-develop",

    "68publishers/asset": "^3",
    "68publishers/webpack-encore-bundle": "^3",
    "mk-j/php_xlsxwriter": "^0",
    "jumbojett/openid-connect-php": "^1"
  },
	"require-dev": {
    "contributte/qa": "^0",
    "mockery/mockery": "^1",
    "nette/tester": "^2",
    "phpstan/phpstan": "^2",
    "symfony/thanks": "^1"
  },
	"autoload": {
		"psr-4": {
			"App\\": "App",
      "Database\\": "Database",
      "Tests\\": "tests"
		}
	},
	"minimum-stability": "stable",
	"config": {
    "platform": {
      "php": "8.5",
      "ext-imagick": "3",
      "ext-intl": "3",
      "ext-exif": "3",
      "ext-zip": "3"
    },
		"allow-plugins": {
			"symfony/thanks": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
