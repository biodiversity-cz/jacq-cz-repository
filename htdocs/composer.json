{
	"name": "biodiversity-cz/jacq-cz-repository",
	"description": "JACQ - Czech integration",
	"keywords": ["jacq", "repository", "NRP"],
	"type": "project",
	"license": ["MIT"],
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/krkabol/iiif-manifest-generator"
    }
  ],
	"require": {
		"php": ">= 8.4",
    "ext-imagick": "*",
    "ext-intl": "*",
    "ext-exif": "*",

		"nette/application": "^3",
		"nette/bootstrap": "^3",
		"nette/caching": "^3",
		"nette/di": "^3",
		"nette/forms": "^3",
		"nette/http": "^3",
		"nette/mail": "^4",
		"nette/robot-loader": "^4",
		"nette/security": "^3",
    "nette/utils": "^4",
    "nettrine/orm": "^0.8",
    "nettrine/dbal": "^0.8.2",
    "nettrine/cache": "^0.3",
    "nettrine/migrations": "^0",
    "latte/latte": "^3",
    "tracy/tracy": "^2",

    "contributte/console": "^0",
    "contributte/console-extra": "^0",
    "contributte/forms-bootstrap": "^0",
    "guzzlehttp/guzzle": "^7",
    "league/pipeline": "^1",
    "picqer/php-barcode-generator": "v3",
    "ublaboo/aws-sdk-nette-extension": "dev-master",
    "ublaboo/datagrid": "^v6",
    "yale-web-technologies/iiif-manifest-generator": "dev-develop",

    "68publishers/asset": "^3",
    "68publishers/webpack-encore-bundle": "^3"
  },
	"require-dev": {
		"nette/tester": "^2",
		"symfony/thanks": "^1",
    "contributte/qa": "^0",
		"phpstan/phpstan": "^2"
	},
	"autoload": {
		"psr-4": {
			"App\\": "App",
      "Tests\\": "tests"
		}
	},
	"minimum-stability": "stable",
	"config": {
    "platform": {
      "php": "8.4",
      "ext-imagick": "3",
      "ext-intl": "3",
      "ext-exif": "3"
    },
		"allow-plugins": {
			"symfony/thanks": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
